<?xml version="1.0" encoding="utf-8"?>
<!-- Vault files are encrypted with a device-bound Keystore key, so they
     must never be included in cloud backups (they could not be decrypted
     on another device anyway). -->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
