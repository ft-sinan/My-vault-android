<?xml version="1.0" encoding="utf-8"?>
<!--
    FT Shield adaptive-icon foreground.

    The cream shield from the original Shield Keyhole icon is retained;
    the keyhole is replaced by a bold geometric FT monogram (the FT
    franchise master mark) with the lime keyhole dot kept beneath it.
    Everything stays inside the adaptive-icon safe zone (roughly
    29.5-78.5 x 22.2-83.2 in the 108dp layer), so circle, squircle,
    rounded-square and teardrop launcher masks do not clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Cream shield. -->
    <path
        android:fillColor="#F2EFE3"
        android:pathData="M54,22.2 L78.5,29.1 L78.5,48.8 C78.5,64.3 68.7,75.5 54,83.2 C39.3,75.5 29.5,64.3 29.5,48.8 L29.5,29.1 Z" />

    <!-- Inner shield line. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#173F35"
        android:strokeWidth="3.6"
        android:strokeLineJoin="round"
        android:pathData="M54,29.9 L70.7,35.1 L70.7,48.8 C70.7,60 63.8,68.6 54,73.8 C44.2,68.6 37.3,60 37.3,48.8 L37.3,35.1 Z" />

    <!-- F of the FT monogram. -->
    <path
        android:fillColor="#173F35"
        android:pathData="M39.5,40 L51.5,40 L51.5,44.6 L44.1,44.6 L44.1,47.2 L51,47.2 L51,51.4 L44.1,51.4 L44.1,58 L39.5,58 Z" />

    <!-- T of the FT monogram. -->
    <path
        android:fillColor="#173F35"
        android:pathData="M56,40 L68.5,40 L68.5,44.6 L64.5,44.6 L64.5,58 L59.9,58 L59.9,44.6 L56,44.6 Z" />

    <!-- Lime keyhole dot. -->
    <path
        android:fillColor="#C8F169"
        android:pathData="M54,64.5 m-3.4,0 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0" />
</vector>
